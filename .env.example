# ==========================================
# CyberRig Environment Configuration Example
# Local Dev Stack: Docker Compose (Postgres 5433, Redis 6380)
# ==========================================

# Application
NODE_ENV=development
PORT=4000
APP_NAME=CyberRig
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL 16 on Host Port 5433)
DATABASE_URL=postgresql://cyberrig_user:cyberrig_dev_password@localhost:5433/cyberrig_db?schema=public

# Cache Configuration (Redis on Host Port 6380)
REDIS_URL=redis://localhost:6380

# Security & Authentication
JWT_SECRET=super-secret-cyberrig-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Storage / Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Logging
LOG_LEVEL=debug
